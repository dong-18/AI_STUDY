        <mxCell id="pgBuC1m57It03755yfct-17" value="&lt;div style=&quot;white-space-collapse: preserve;&quot; data-line=&quot;true&quot; data-line-index=&quot;0&quot; data-zone-id=&quot;0&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;服务器这边会将多个连接的请求放入一个线程，&lt;span style=&quot;background-color: transparent;&quot;&gt;，也有异步需求的注解 &lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="175" y="280" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pgBuC1m57It03755yfct-30" value="游戏服接受完数据，会走通过dbclass注册的回调，然后将数据进行解析存储，再走&lt;span style=&quot;white-space-collapse: preserve; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;onUserDataLoad，通过bit分析是否都加载完毕，加载完毕就发送10009给客户端，告知客户端可以发送下一步的请求&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="200" y="460" width="230" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pgBuC1m57It03755yfct-27" value="游戏服是客户端，通过&lt;span style=&quot;white-space-collapse: preserve; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;RPCClientHandler接受数据&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="430" y="410" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7baba1c4bc27f4b0-11" value="http请求" style="html=1;verticalAlign=bottom;endArrow=block;labelBackgroundColor=none;fontFamily=Verdana;fontSize=12;edgeStyle=elbowEdgeStyle;elbow=vertical;exitX=0.5;exitY=0.043;exitDx=0;exitDy=0;exitPerimeter=0;" parent="1" source="7baba1c4bc27f4b0-9" edge="1">
