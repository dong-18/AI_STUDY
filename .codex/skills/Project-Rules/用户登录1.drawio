          </mxGeometry>
        </mxCell>
        <mxCell id="7baba1c4bc27f4b0-14" value="负载均衡选择合适的connSvr" style="html=1;verticalAlign=bottom;endArrow=block;labelBackgroundColor=none;fontFamily=Verdana;fontSize=12;edgeStyle=elbowEdgeStyle;elbow=vertical;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
